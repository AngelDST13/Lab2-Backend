# Copiar como .env y completar
NODE_ENV=development
PORT=3000

# Archivo SQLite (se crea con: npm run db:init)
DATABASE_PATH=./data/circuito.db

# Orígenes permitidos para CORS (separados por coma). Con cookies no se permite "*".
CORS_ORIGIN=http://localhost:5173

# Duración de la sesión en horas (7 días)
SESSION_TTL_HOURS=168

# Webhook del agente de IA en n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tienda/asistente
# Mismo valor que la credencial Header Auth "X-Webhook-Secret" del webhook en n8n
N8N_WEBHOOK_SECRET=
# Token con el que las herramientas del agente consultan la API (mínimo 32 caracteres).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_TOKEN=
